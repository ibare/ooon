{
  "name": "@oon/plugin-tiptap",
  "version": "0.0.0",
  "private": true,
  "description": "Oon Tiptap 플러그인 — 코드 펜스/인라인 코드에서 DSL 감지",
  "type": "module",
  "main": "./dist/index.js",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "files": ["dist", "README.md"],
  "scripts": {
    "build": "tsup",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "clean": "rm -rf dist .tsbuildinfo"
  },
  "dependencies": {
    "@oon/core": "workspace:*",
    "@oon/projector-web": "workspace:*",
    "@oon/shared": "workspace:*"
  },
  "peerDependencies": {
    "@tiptap/core": ">=2.6.0",
    "@tiptap/pm": ">=2.6.0"
  },
  "devDependencies": {
    "@oon/tsconfig": "workspace:*",
    "@tiptap/core": "^2.6.6",
    "@tiptap/pm": "^2.6.6",
    "tsup": "^8.2.4",
    "typescript": "^5.5.4",
    "vitest": "^2.1.1"
  }
}
