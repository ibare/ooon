{
  "name": "@oon/editor-web",
  "version": "0.0.0",
  "private": true,
  "description": "Oon 점수 편집기 — 빈 악보 기반 박자 오버레이/오선 튕기기/노트 배치 UX 캔버스 구현",
  "type": "module",
  "main": "./dist/index.js",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "files": ["dist", "README.md"],
  "scripts": {
    "build": "tsup",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "clean": "rm -rf dist .tsbuildinfo"
  },
  "dependencies": {
    "@oon/core": "workspace:*",
    "@oon/editor-core": "workspace:*",
    "@oon/instrument-layouts": "workspace:*",
    "@oon/projector-web": "workspace:*",
    "@oon/score-engraving": "workspace:*",
    "@oon/shared": "workspace:*"
  },
  "peerDependencies": {
    "smplr": ">=0.20.0"
  },
  "devDependencies": {
    "@oon/tsconfig": "workspace:*",
    "smplr": "^0.20.0",
    "tsup": "^8.2.4",
    "typescript": "^5.5.4",
    "vitest": "^2.1.1"
  }
}
