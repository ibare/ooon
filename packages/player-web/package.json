{
  "name": "@ooon/player-web",
  "version": "0.0.0",
  "private": true,
  "description": "Ooon 인터랙티브 블록 플레이어 — DSL 한 줄로 캔버스 + 컨트롤 + 오디오 통합 컨테이너",
  "type": "module",
  "main": "./dist/index.js",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "files": ["dist", "README.md"],
  "scripts": {
    "build": "tsup",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "clean": "rm -rf dist .tsbuildinfo"
  },
  "dependencies": {
    "@ooon/audio-engine-web": "workspace:*",
    "@ooon/composition": "workspace:*",
    "@ooon/core": "workspace:*",
    "@ooon/editor-web": "workspace:*",
    "@ooon/instrument-layouts": "workspace:*",
    "@ooon/projector-web": "workspace:*",
    "@ooon/score-engraving": "workspace:*",
    "@ooon/shared": "workspace:*"
  },
  "devDependencies": {
    "@ooon/tsconfig": "workspace:*",
    "tsup": "^8.2.4",
    "typescript": "^5.5.4",
    "vitest": "^2.1.1"
  }
}
