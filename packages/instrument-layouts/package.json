{
  "name": "@ooon/instrument-layouts",
  "version": "0.0.0",
  "private": true,
  "description": "Ooon 악기 레이아웃 — keyboard/fretboard/drum/progression layout 계산",
  "type": "module",
  "main": "./dist/index.js",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
