{
  "name": "@ooon/audio-engine-web",
  "version": "0.0.0",
  "private": true,
  "description": "Ooon AudioEngine 인터페이스의 smplr 기반 웹 어댑터 — 재생기/편집기/플러그인이 공유",
  "type": "module",
  "main": "./dist/index.js",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "files": ["dist", "README.md"],
  "scripts": {
    "build": "tsup",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "clean": "rm -rf dist .tsbuildinfo"
  },
  "dependencies": {
    "@ooon/shared": "workspace:*"
  },
  "peerDependencies": {
    "smplr": ">=0.20.0"
  },
  "devDependencies": {
    "@ooon/tsconfig": "workspace:*",
    "smplr": "^0.20.0",
    "tsup": "^8.2.4",
    "typescript": "^5.5.4",
    "vitest": "^2.1.1"
  }
}
