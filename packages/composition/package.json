{
  "name": "@oon/composition",
  "version": "0.0.0",
  "private": true,
  "description": "Oon 합성 레이아웃 — 여러 악기 layout을 수직 적층하는 song layout",
  "type": "module",
  "main": "./dist/index.js",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "files": ["dist", "README.md"],
  "scripts": {
    "build": "tsup",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "clean": "rm -rf dist .tsbuildinfo"
  },
  "dependencies": {
    "@oon/core": "workspace:*",
    "@oon/instrument-layouts": "workspace:*",
    "@oon/score-engraving": "workspace:*"
  },
  "devDependencies": {
    "@oon/tsconfig": "workspace:*",
    "tsup": "^8.2.4",
    "typescript": "^5.5.4",
    "vitest": "^2.1.1"
  }
}
