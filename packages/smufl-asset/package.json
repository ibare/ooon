{
  "name": "@ooon/smufl-asset",
  "version": "0.0.0",
  "private": true,
  "description": "SMuFL 자산 — Bravura 폰트와 메타데이터(글리프 bbox/anchors, engravingDefaults)를 sp 단위 그대로 노출. 플랫폼 독립.",
  "type": "module",
  "main": "./dist/index.js",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./font/Bravura.woff2": "./assets/Bravura.woff2"
  },
  "files": [
    "dist",
    "assets/Bravura.woff2",
    "assets/Bravura-OFL.txt",
    "README.md"
  ],
  "scripts": {
    "build": "tsup",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "generate": "tsx scripts/extract-metadata.ts",
    "clean": "rm -rf dist .tsbuildinfo"
  },
  "devDependencies": {
    "@ooon/tsconfig": "workspace:*",
    "tsup": "^8.2.4",
    "tsx": "^4.19.0",
    "typescript": "^5.5.4",
    "vitest": "^2.1.1"
  }
}
